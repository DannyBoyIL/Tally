# Local Postgres (docker compose)
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_DB=tally
DATABASE_URL=postgres://tally:tally@localhost:5432/tally

# Phase 2+: model calls (eval and API). Fill in your own .env, never commit it.
ANTHROPIC_API_KEY=

# API (phase 4). replay = recorded golden-set responses, no key or cost; live = calls Claude.
EXTRACTOR=replay
API_PORT=3000
REVIEWER=demo-reviewer
