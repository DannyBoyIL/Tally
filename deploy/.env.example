# Copy to ~/tally/.env on the server (chmod 600). Never commit the real file.

# The public hostname. Without a domain of your own: <elastic-ip-with-dashes>.sslip.io,
# e.g. 3-120-45-67.sslip.io, which resolves to that IP.
DOMAIN=

# Any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=

# Live extraction of visitors' own images. Leave both empty to keep the demo replay-only (free).
DEMO_ACCESS_CODE=
ANTHROPIC_API_KEY=
DEMO_LIVE_DAILY_CAP=20
